{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FOR HER question authoring schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "subject",
    "topic",
    "difficulty",
    "marks",
    "question",
    "solution",
    "sourceType",
    "verified",
    "verification",
    "reusePermission",
    "contentVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "MCQ",
        "MSQ",
        "NAT"
      ]
    },
    "subject": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "subtopic": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "marks": {
      "enum": [
        1,
        2
      ]
    },
    "question": {
      "type": "string",
      "minLength": 10
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "acceptedRange": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "correctAnswer": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "solution": {
      "type": "object",
      "required": [
        "given",
        "asked",
        "concept",
        "formula",
        "steps",
        "finalAnswer",
        "explanation",
        "commonMistakes"
      ],
      "properties": {
        "given": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "asked": {
          "type": "string"
        },
        "concept": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "finalAnswer": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "commonMistakes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "src",
          "alt"
        ],
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^assets/"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sourceType": {
      "enum": [
        "original",
        "pyq"
      ]
    },
    "sourceUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceYear": {
      "type": [
        "integer",
        "null"
      ]
    },
    "verified": {
      "type": "boolean"
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "answer",
        "solution",
        "method",
        "evidence"
      ]
    },
    "reusePermission": {
      "enum": [
        "original-project-content",
        "cleared",
        "unresolved"
      ]
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "originalQuestionNumber": {
      "type": [
        "string",
        "integer"
      ]
    },
    "originalType": {
      "type": "string"
    },
    "originalMarking": {
      "type": "object",
      "required": [
        "incorrectPenalty"
      ],
      "properties": {
        "incorrectPenalty": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "acceptedRanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "NAT"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "acceptedRange"
            ]
          },
          {
            "required": [
              "acceptedRanges"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "MCQ",
              "MSQ"
            ]
          }
        }
      },
      "then": {
        "required": [
          "options",
          "correctAnswer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "pyq"
          }
        }
      },
      "then": {
        "required": [
          "sourceUrl",
          "sourceYear",
          "originalQuestionNumber",
          "originalType",
          "originalMarking"
        ]
      }
    }
  ]
}
